# Unreal Engine project files that should stay in Git:
#   *.uproject
#   Config/
#   Content/
#   Source/
#   Plugins/ source and plugin descriptors
#   Build/ project resources such as icons, splash screens, and platform files

# Unreal generated folders
Binaries/
DerivedDataCache/
Intermediate/
Saved/

# Plugin generated folders
Plugins/**/Intermediate/
Plugins/**/Saved/

# If all plugins are source-built, these binaries can remain ignored.
# Remove this rule or add per-plugin exceptions for binary-only marketplace plugins.
Plugins/**/Binaries/

# Local Unreal build and runtime artifacts
*.target
*.modules
*.version
*.receipt
*.uatbuildrecord
*.tmp
*.log
*.dmp
*.crash
*.nprof
*.utrace
*.ucas.tmp
*.utoc.tmp

# Local-only migrated asset over GitHub's 100 MB file limit
Content/Effects/Textures/Flipbooks/SmokeSwirl_3_Flipbook_CHANNELPACK.uasset

# Generated project files
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace
*.xcodeproj/
*.xcworkspace/

# Visual Studio / MSBuild / Rider / ReSharper
.vs/
.idea/
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user
_ReSharper*/
*.rsuser

